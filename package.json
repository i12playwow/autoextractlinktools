{
  "name": "autoextractlinktools",
  "version": "1.0.0",
  "description": "Electron desktop app with a Chrome extension bridge, plus an optional userscript path, for extracting video player links and forwarding them to the local desktop app",
  "license": "MIT",
  "main": "src/main.js",
  "bin": {
    "autoextract": "./bin/autoextract.js"
  },
  "files": [
    "src/",
    "shared/",
    "bin/",
    "chrome-extension/",
    "userscript/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/autoextract.js",
    "desktop": "electron src",
    "dev:desktop": "electron src",
    "build:extension": "node chrome-extension/build/make-shared.js",
    "clean:extension": "node -e \"const fs=require('fs'); try{ fs.rmSync('chrome-extension/shared',{recursive:true}); }catch(e){}\"",
    "test": "node test-desktop-contract.js && node test-shared-detect.js && node test-storage.js && node test-renderer-filter.js && node test-renderer-verify.js && node test-desktop-bridge-edge-cases.js && node test-cli-extract.js",
    "test:light": "node scripts/ci-test-summary.js --light",
    "test:mirror": "node scripts/ci-test-summary.js --check-mirror"
  },
  "keywords": [
    "video",
    "extract",
    "links",
    "puppeteer",
    "electron",
    "chrome-extension",
    "desktop"
  ],
  "dependencies": {
    "commander": "^12.0.0",
    "electron": "^33.4.11",
    "puppeteer-core": "^25.2.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
